# Local PostgreSQL example:
DATABASE_URL=

# Supabase direct connections and Session pooler connections require SSL.
# Keep the real password only in backend/.env. The setup script safely writes it.
DATABASE_SSLMODE=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_APPLICATION_NAME=edvatiq_api

JWT_SECRET_KEY=
ENVIRONMENT=development
# Local convenience only. Keep both false in serverless/production and run the
# initialization command once during deployment instead.
RUN_STARTUP_MIGRATIONS=true
RUN_STARTUP_SEEDING=true
CORS_ORIGINS=http://localhost:3000,https://edvatiq.app,https://www.edvatiq.app
APP_URL=http://localhost:3000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_MAX_ATTEMPTS=5
SIGNUP_EMAIL_PROOF_TTL_MINUTES=30
SIGNUP_EMAIL_RESEND_SECONDS=60
SIGNUP_EMAIL_MAX_SENDS_15_MINUTES=3

AI_API_KEY=
AI_MODEL_BASIC=gpt-5.4-mini
AI_MODEL=gpt-5.4-mini
AI_COMPILE_TIMEOUT_SECONDS=8
AI_ANSWER_TIMEOUT_SECONDS=9
AI_INTERACTIVE_DEADLINE_SECONDS=25
EMAIL_PROVIDER=resend
EMAIL_SEND_TIMEOUT_SECONDS=8
RESEND_API_KEY=
RESEND_FROM_EMAIL=Edvatiq <onboarding@resend.dev>
PROVIDER_MOCK_MODE=true
PAYMENT_GATEWAY=razorpay
RAZORPAY_MODE=mock
CASHFREE_MODE=mock
CASHFREE_API_VERSION=2026-01-01
CASHFREE_TEST_APP_ID=
CASHFREE_TEST_SECRET_KEY=
CASHFREE_TEST_WEBHOOK_SECRET=
CASHFREE_LIVE_APP_ID=
CASHFREE_LIVE_SECRET_KEY=
CASHFREE_LIVE_WEBHOOK_SECRET=
